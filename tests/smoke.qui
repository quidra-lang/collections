import collections

string[] words := ["apple", "banana", "apple"]
counts := collections.frequencies(words)
match counts.get("apple")
    nat count
        println("apple={count}")
    none
        println("missing")

collections.PriorityQueue<string, int> queue := collections.PriorityQueue<string, int>()
.queue.push("email", 3)
.queue.push("deploy", 1)
.queue.push("backup", 1)
println("size={queue.size()}")
match .queue.pop()
    (string value, int priority)
        println("{value}:{priority}")
    none
        println("missing")
match .queue.pop()
    (string value, int priority)
        println("{value}:{priority}")
    none
        println("missing")
match .queue.pop()
    (string value, int priority)
        println("{value}:{priority}")
    none
        println("missing")
println("empty={queue.empty()}")

string[] regions := ["east", "west", "east"]
int[] amounts := [3, 5, 7]
totals := collections.group_sum<string, int>(regions, amounts)
match totals.get("east")
    int total
        println("east={total}")
    none
        println("missing")
string[] invalid_keys := ["a", "b"]
int[] invalid_values := [1]
match collections.group_sum<string, int>(invalid_keys, invalid_values)
    map<string, int> invalid
        println("unexpected")
    error problem
        println("length-error")
groups := collections.runs(["a", "a", "b", "a"])
(run_text, run_count) := groups[0]
println("runs={len(groups)}:{run_text}:{run_count}")
int[] aa := [1, 2]
int[] bb := [1, 3]
int[] cc := [1, 2, 0]
println("lex={collections.lex_compare(aa, bb)}")
println("lex-equal={collections.lex_compare(aa, aa)}")
println("lex-prefix={collections.lex_compare(aa, cc)}")

bool alphabetical(string left, string right)
    return [left, right].sorted()[0] == left and left != right

func<bool>(string, string) order_by_name := alphabetical
collections.PriorityQueue<string, int> named := collections.PriorityQueue<string, int>(tie_before = order_by_name)
.named.push("zebra", 2)
.named.push("apple", 2)
.named.push("beta", 1)
match .named.pop()
    (string value, int priority)
        println("named={value}:{priority}")
    none
        println("missing")
match .named.pop()
    (string value, int priority)
        println("named={value}:{priority}")
    none
        println("missing")
match .named.pop()
    (string value, int priority)
        println("named={value}:{priority}")
    none
        println("missing")

int[][] sequences := [[4, 5, 4, 3], [4, 6, 5, 2], [4, 6, 5, 2]]
nat[] ranked := collections.lex_order(sequences, descending = true)
println("rank={ranked[0]}:{ranked[1]}:{ranked[2]}")
