import collections

int[] values := [7, 3, 7, 2, 3]
int[] stable := collections.unique(values)
println("unique={stable[0]}:{stable[1]}:{stable[2]}")
int[] empty := []
println("empty={#collections.unique(empty)}")
println("index={collections.index(values, 3)}")
match collections.index(values, 99)
    nat unexpected
        println("unexpected")
    error problem
        println("missing={problem.code}")
match collections.index(empty, 7)
    nat unexpected
        println("unexpected")
    error problem
        println("empty-index={problem.code}")
string[] keys := ["b", "a", "b", "a", "b"]
grouped := collections.group_by(keys, values)
println("keys={grouped.keys().join("|")}")
match grouped.get("b")
    int[] group
        println("group={group[0]}:{group[1]}:{group[2]}")
    none
        println("unexpected")
string[] no_keys := []
no_groups := collections.group_by(no_keys, empty)
println("empty-groups={no_groups.size()}")
match collections.group_by(keys, empty)
    map<string, int[]> unexpected
        println("unexpected")
    error problem
        println("length={problem.code}")
println("unchanged={#values}:{values[0]}:{values[4]}")

distinct<int> items := collections.to_distinct(values)
int[] ordered := items.values()
println("distinct={ordered[0]}:{ordered[1]}:{ordered[2]}")
println("empty-distinct={collections.to_distinct(empty).size()}")
sorted_items := items.sorted()
println("sorted-distinct={sorted_items[0]}:{sorted_items[1]}:{sorted_items[2]}")
sorted_items[0] = 100
println("sorted-independent={items.values()[0]}:{items.has(2)}")
println("empty-sorted-distinct={#empty.to_distinct().sorted()}")
println("sorted-distinct-strings={["z", "a", "z"].to_distinct().sorted().join("|")}")
sorted_flags := [true, false].to_distinct().sorted()
println("sorted-distinct-bools={sorted_flags[0]}:{sorted_flags[1]}")
.items.add(99)
stable[0] = 100
println("independent={#values}:{values[0]}:{items.size()}")

string[] repeated := ["first", "second", "first"]
string[] unique_words := collections.unique(repeated)
println("words={unique_words.join("|")}")
println("first-index={collections.index(values, 7)}")
println("extensions={values.index(2)}:{#values.unique()}:{values.to_distinct().size()}")
real64[] decimals := [1.25, 2.5, 1.25]
println("float-index={collections.index(decimals, 1.25)}")
match collections.group_by(no_keys, values)
    map<string, int[]> unexpected
        println("unexpected")
    error problem
        println("extra-values={problem.code}")
(string, int)[] pairs := [("a", 1), ("b", 2), ("a", 1)]
distinct<(string, int)> pair_set := collections.to_distinct(pairs)
string[] labels := ["x", "y", "z"]
paired := collections.group_by(pairs, labels)
match paired.get(("a", 1))
    string[] group
        println("tuple={pair_set.size()}:{group.join("|")}")
    none
        println("unexpected")
int[] copy := []
match grouped.get("b")
    int[] group
        copy = group
    none
        println("unexpected")
copy[0] = 999
match grouped.get("b")
    int[] group
        println("group-independent={group[0]}")
    none
        println("unexpected")

collections.Queue<string> pending := collections.Queue<string>()
println("queue-empty={pending.empty()}")
.pending.push("first")
.pending.push("second")
copied_queue := pending
match .pending.pop()
    string first
        println("queue-first={first}")
    none
        println("queue-missing")
.pending.push("third")
while not pending.empty()
    match .pending.pop()
        string item
            println("queue-next={item}")
        none
            println("queue-missing")
println("queue-copy-size={copied_queue.size()}")

class Scored(string name, int score)
int score_of(Scored item)
    return item.score
Scored[] scored := [Scored("first", 1), Scored("second", 2), Scored("third", 1)]
func<int(Scored)> select_score := score_of
ranked_records := collections.sorted_by(scored, select_score, descending = true)
println("scored={ranked_records[0].name}:{ranked_records[1].name}:{ranked_records[2].name}")

map<string, int> scores
.scores.set("second", 2)
.scores.set("first", 1)
.scores.set("second", 3)
score_entries := collections.entries(scores)
for (name, score) := score_entries[]
    println("entry={name}:{score}")
match .pending.take()
    string unexpected
        println("unexpected={unexpected}")
    error failure
        println("queue-drained={failure.code}")
collections.Queue<int> seeded := collections.Queue<int>([7, 9])
int seeded_first := .seeded.take()
int seeded_second := .seeded.take()
println("queue-seeded={seeded_first}:{seeded_second}")
collections.Queue<int | string> mixed := collections.Queue<int | string>()
.mixed.push("union")
match .mixed.take()
    int unexpected
        println("unexpected={unexpected}")
    string value
        println("queue-union={value}")
    error failure
        println("unexpected={failure.code}")

map<string, int> totals
.totals.set("z", 3)
.totals.set("b", 1)
.totals.set("a", 3)
for (label, amount) := collections.sorted_entries(totals)[]
    println("sorted={label}:{amount}")
for (label, amount) := collections.ranked_entries(totals)[]
    println("ranked={label}:{amount}")
map<string, int> empty_totals
println("empty-ranked={#collections.ranked_entries(empty_totals)}")

map<string, string[]> groups_for_sort
.groups_for_sort.set("z", ["last"])
.groups_for_sort.set("a", ["first"])
sorted_groups := collections.sorted_entries(groups_for_sort)
for (group_key, group_items) := sorted_groups[]
    println("sorted-group={group_key}:{group_items.join(",")}")

int[] search_values := [7, 3, 7]
match search_values.find_index(7)
    nat position
        println("found={position}")
    none
        println("unexpected miss")
int[] no_search_values := []
for input := [search_values, no_search_values][]
    match input.find_index(5)
        nat position
            println("unexpected index {position}")
        none
            println("absent")
