import collections

int[] values := [1, 2, 1]
int[] copied := values
.values.push(3)
println("push={values.len()}:{values[3]}:{copied.len()}")
println("remove={.values.remove(1)}:{values[0]}:{values.len()}")
println("remove-missing={.values.remove(9)}:{values.len()}")
.values.insert(position = 0, value = 7)
.values.insert(values.len(), 8)
.values.insert(2, 9)
println("insert={values[0]}:{values[2]}:{values[5]}")
println("take={.values.take()}:{values.len()}")
match .values.pop()
    int value
        println("pop={value}:{values.len()}")
    none
        println("unexpected")
println("copy={copied[0]}:{copied[1]}:{copied[2]}")
match .values.insert(99, 4)
    void
        println("unexpected")
    error failure
        println("insert-error={failure.code}:{values.len()}:{values[0]}:{values[2]}")
println("remove-last={.values.remove(1)}:{values.len()}")
println("remove-middle={.values.remove(2)}:{values[1]}")
int[] single := [4]
println("remove-single={.single.remove(4)}:{single.len()}")
int[] empty := []
println("remove-empty={.empty.remove(1)}")
match .empty.pop()
    int value
        println("unexpected")
    none
        println("empty-pop=none")
match .empty.take()
    int value
        println("unexpected")
    error failure
        println("empty-take={failure.code}")
.empty.insert(0, 5)
println("insert-empty={.empty.take()}:{empty.len()}")
.empty.push(6)
println("pop-single={.empty.take()}:{empty.len()}")
(string, int)[] pairs := [("a", 1)]
.pairs.push(("b", 2))
println("tuple-remove={.pairs.remove(("a", 1))}")
(label, number) := .pairs.take()
println("tuple-take={label}:{number}")
class Item(int id)
Item[] items := []
.items.push(Item(7))
Item item := .items.take()
println("class-take={item.id}")
collections.PriorityQueue<string, int> queue := collections.PriorityQueue<string, int>()
.queue.push("later", 3)
.queue.push("first", 1)
.queue.push("second", 1)
queue_copy := queue
while not queue.empty()
    (name, priority) := .queue.take()
    println("priority-take={name}:{priority}")
println("priority-copy={queue_copy.size()}")
match .queue.take()
    (string name, int priority)
        println("unexpected")
    error failure
        println("priority-empty={failure.code}")

int[] positions := [9, 4, 9, 6]
int removed_at := .positions.remove_at(position = 2)
println("remove-at={removed_at}:{positions == [int(9), 4, 6]}")
match .positions.remove_at(3)
    error problem
        println("remove-at-error={problem.code}:{positions.len()}")
    int
        println("unexpected removal")
int last_at := .positions.remove_at(2)
int first_at := .positions.remove_at(0)
int only_at := .positions.remove_at(0)
println("remove-at-boundaries={last_at}:{first_at}:{only_at}:{positions.len()}")
