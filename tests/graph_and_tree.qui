import collections

(int, int)[] edges := [(2, 0), (0, 1), (0, 0), (0, 1)]
int[][] graph := collections.adjacency_lists(4, edges, undirected = true)
println(graph == [[0, 1, 1, 2], [0, 0], [0], []])
int[][] directed := collections.adjacency_lists(4, edges)
println(directed == [[0, 1, 1], [], [0], []])
match collections.adjacency_lists(2, [(-1, 0)])
    error problem
        println(problem.code)
    int[][]
        println("unexpected graph")

(int, int, int)[] weighted := [(2, 0, 9), (0, 1, 8), (0, 0, 0), (0, 1, 3)]
(int, int)[][] undirected := collections.weighted_adjacency_lists(4, weighted, undirected = true)
println(undirected == [[(0, 0), (1, 8), (1, 3), (2, 9)], [(0, 8), (0, 3)], [(0, 9)], []])
(int, int)[][] one_way := collections.weighted_adjacency_lists(4, weighted)
println(one_way == [[(0, 0), (1, 8), (1, 3)], [], [(0, 9)], []])
match collections.weighted_adjacency_lists(2, [(0, 2, 1)])
    error problem
        println(problem.code)
    (int, int)[][]
        println("unexpected weighted graph")

class Record(string name, int score, int tie)
(int, int) rank(Record record)
    return (record.score, record.tie)

Record[] records := [Record("first", 2, 1), Record("second", 1, 3), Record("third", 2, 1), Record("fourth", 2, 0)]
func<(int, int)(Record)> key := rank
sorted := records.sorted_by_pair(key, descending = (true, false))
println([for Record record := sorted[] then record.name].join(":"))

collections.BinaryNodes<int> nodes := collections.BinaryNodes<int>()
leaf := .nodes.add(7)
root := .nodes.add(5, right = leaf)
copy := nodes
.nodes.set(root, collections.BinaryNode<int>(8, left = leaf))
original := copy.get(root)
updated := nodes.get(root)
child := nodes.get(updated.left)
println("{original.value}:{updated.value}:{child.value}")
match nodes.get(none)
    error problem
        println(problem.code)
    collections.BinaryNode<int>
        println("unexpected node")
int[] preorder := nodes.traverse(root, "preorder")
println(preorder == [int(8), 7])
int[] inorder := nodes.traverse(root, "inorder")
println(inorder == [int(7), 8])
int[] postorder := nodes.traverse(root, "postorder")
println(postorder == [int(7), 8])
int[] levelorder := nodes.levelorder(root)
println(levelorder == [int(8), 7])
println("{nodes.height(root)}:{nodes.height(none)}")
first := nodes.leftmost(root)
first_node := nodes.get(first)
println(first_node.value)

collections.BinaryNodes<int> successor_tree := collections.BinaryNodes<int>()
successor_child := .successor_tree.add(34)
successor := .successor_tree.add(31, right = successor_child)
subtree := .successor_tree.add(39, left = successor)
(extracted, remaining) := .successor_tree.detach_leftmost(subtree)
remaining_root := successor_tree.get(remaining)
replacement := successor_tree.get(remaining_root.left)
println("{extracted}:{remaining_root.value}:{replacement.value}")
(minimum, new_root) := .successor_tree.detach_leftmost(successor)
promoted := successor_tree.get(new_root)
println("{minimum}:{promoted.value}")
match .successor_tree.detach_leftmost(collections.NodeId(100))
    error problem
        println(problem.code)
    (int, collections.NodeId | none)
        println("unexpected successor")

string[] labels := ["z", "a", "isolated"]
(string, string)[] labeled_edges := [("z", "a"), ("z", "z"), ("z", "a")]
collections.DirectedGraph labeled := collections.directed_graph(labels, labeled_edges)
nat[] outgoing := labeled.outgoing(0)
int[] indegrees := labeled.indegrees()
println(outgoing == [nat(1), 0, 1] and indegrees == [int(1), 2, 0])
indegrees[1] = 0
println(labeled.indegrees()[1] == 2 and #labeled.outgoing(2) == 0)
(int, int)[] no_edges := []
int[] no_vertices := []
collections.DirectedGraph empty_graph := collections.directed_graph(no_vertices, no_edges)
println(#empty_graph.indegrees() == 0)
match collections.directed_graph(["a", "a"], labeled_edges)
    error problem
        println(problem.code)
    collections.DirectedGraph
        println("unexpected graph")
(string, string)[] unknown_source := [("missing", "a")]
match collections.directed_graph(labels, unknown_source)
    error problem
        println(problem.code)
    collections.DirectedGraph
        println("unexpected graph")
(string, string)[] unknown_target := [("a", "missing")]
match collections.directed_graph(labels, unknown_target)
    error problem
        println(problem.code)
    collections.DirectedGraph
        println("unexpected graph")
